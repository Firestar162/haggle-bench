<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>HaggleBench</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 640px; margin: 0 auto; padding: 16px; }
    #log { border: 1px solid #ccc; border-radius: 8px; padding: 12px; height: 340px; overflow-y: auto; }
    .msg { margin: 8px 0; padding: 8px 12px; border-radius: 12px; max-width: 85%; white-space: pre-wrap; }
    .you { background: #dbeafe; margin-left: auto; }
    .shop { background: #f3f4f6; }
    #banner { display: none; background: #dc2626; color: white; padding: 12px; border-radius: 8px; margin: 12px 0; font-weight: bold; }
    form { display: flex; gap: 8px; margin-top: 12px; }
    input { flex: 1; padding: 10px; font-size: 16px; }
    button { padding: 10px 16px; font-size: 16px; }
    .orders-panel { margin-top: 24px; padding: 16px; border: 1px solid #e2e8f0; border-radius: 12px; }
    .orders-panel h2 { margin: 0 0 12px; font-size: 1.125rem; }
    .orders-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
    .order-empty { color: #475569; padding: 8px 0; }
    .order-card {
      display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center;
      gap: 10px; padding: 12px; border: 1px solid #86efac; border-radius: 8px;
      background: #f0fdf4; color: #14532d;
    }
    .order-card--broken { border-color: #fca5a5; background: #fef2f2; color: #991b1b; }
    .order-product { display: block; font-weight: 650; text-transform: capitalize; overflow-wrap: anywhere; }
    .order-status { display: block; margin-top: 2px; font-size: .875rem; }
    .order-breakdown { display: block; margin-top: 6px; font-size: .875rem; }
    .order-price { font-weight: 700; font-variant-numeric: tabular-nums; }
  </style>
</head>
<body>
  <h1>HaggleBench 🛒</h1>
  <p>Can you get the shopkeeper to sell below its secret minimum price?</p>
  <ul>
    <% products.forEach(p => { %>
      <li><%= p.name %>: £<%= p.list %></li>
    <% }) %>
  </ul>

  <div id="banner"></div>
  <div id="log"></div>

  <form id="form">
    <input id="input" placeholder="Try to haggle..." autocomplete="off">
    <button>Send</button>
  </form>
  <p><button id="reset" type="button">New game</button></p>

  <section class="orders-panel" aria-labelledby="orders-title">
    <h2 id="orders-title">Orders</h2>
    <ul id="orders" class="orders-list" aria-live="polite">
      <li class="order-empty">No orders yet.</li>
    </ul>
  </section>

  <script>
    let sessionId = crypto.randomUUID();
    const log = document.getElementById("log");
    const form = document.getElementById("form");
    const input = document.getElementById("input");
    const orders = document.getElementById("orders");
    const banner = document.getElementById("banner");

    const pounds = new Intl.NumberFormat("en-GB", {
      style: "currency",
      currency: "GBP",
    });

    function renderOrders(entries) {
      if (!entries.length) {
        const empty = document.createElement("li");
        empty.className = "order-empty";
        empty.textContent = "No orders yet.";
        orders.replaceChildren(empty);
        return;
      }

      orders.replaceChildren(...entries.map((order) => {
        const card = document.createElement("li");
        card.className = order.broken ? "order-card order-card--broken" : "order-card";
        const details = document.createElement("div");
        const product = document.createElement("span");
        product.className = "order-product";
        product.textContent = order.product;
        const status = document.createElement("span");
        status.className = "order-status";
        status.textContent = order.broken ? "Break achieved" : "Regular sale";
        details.append(product, status);

        if (order.broken) {
          const breakdown = document.createElement("span");
          breakdown.className = "order-breakdown";
          const floor = pounds.format(order.floor);
          const difference = pounds.format(order.floor - order.price);
          breakdown.textContent = `Floor ${floor} · ${difference} below`;
          details.append(breakdown);
        }

        const price = document.createElement("span");
        price.className = "order-price";
        price.textContent = pounds.format(order.price);
        card.append(details, price);
        return card;
      }));
    }

    function add(who, text) {
      const d = document.createElement("div");
      d.className = "msg " + who;
      d.textContent = text;
      log.appendChild(d);
      log.scrollTop = log.scrollHeight;
      return d;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const message = input.value.trim();
      if (!message) return;
      input.value = "";
      add("you", message);
      const bubble = add("shop", "...");
      try {
        const res = await fetch("/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ sessionId, message }),
        });
        const data = await res.json();
        bubble.textContent = data.reply || data.error;
        if (data.orders) {
          renderOrders(data.orders);
        }
        if (data.broken) {
          banner.style.display = "block";
          banner.textContent = "🎉 You broke the shopkeeper! It sold below the secret minimum.";
        }
      } catch {
        bubble.textContent = "Couldn't reach the server.";
      }
    });

    document.getElementById("reset").addEventListener("click", () => {
      sessionId = crypto.randomUUID();
      log.innerHTML = "";
      renderOrders([]);
      banner.style.display = "none";
    });
  </script>
</body>
</html>